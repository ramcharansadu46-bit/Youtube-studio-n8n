      "parameters": {
        "jsCode": "const items = $input.first().json.items || [];\nconst titles = items.map(i => i.snippet.title).join('\\n- ');\nreturn [{ json: { trendingTitles: '- ' + titles } }];"
      },
      "id": "bdd06e89-22a3-48d9-9344-3fd56df36189",
