    {
      "parameters": {
        "jsCode": "const scenes = $('Split Out Scenes').all();\nconst images = $('Save Image to Drive').all();\nconst audios = $('Save Audio to Drive').all();\nconst videoClips = [];\nconst audioClips = [];\nlet start = 0;\nfor (let i = 0; i < scenes.length; i++) {\n  const duration = 6;\n  const imageUrl = images[i]?.json?.webContentLink || images[i]?.json?.webViewLink || '';\n  const audioUrl = audios[i]?.json?.webContentLink || '';\n  videoClips.push({ asset: { type: 'image', src: imageUrl }, start, length: duration, effect: 'zoomIn', transition: { in: 'fade', out: 'fade' } });\n  audioClips.push({ asset: { type: 'audio', src: audioUrl }, start, length: duration });\n  start += duration;\n}\nconst edit = { timeline: { background: '#FFF8E7', tracks: [ { clips: videoClips }, { clips: audioClips } ] }, output: { format: 'mp4', resolution: 'hd' } };\nreturn [{ json: { edit } }];"
      },
