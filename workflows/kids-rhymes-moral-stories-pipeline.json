    {
      "parameters": {
        "promptType": "define",
        "text": "=You are writing scripts for a YouTube channel of rhymes and moral stories for ages 2-6. Here are currently trending titles in this niche for inspiration (do not copy, just note themes):\n{{ $json.trendingTitles }}\n\nWrite 6 ORIGINAL candidate scripts. For each: 60-90 seconds read-aloud length, simple vocabulary, rhyming/repetitive structure, one clear moral. Return ONLY a JSON array, no markdown fences, no preamble, in this exact shape: [{\"title\":\"...\",\"moral\":\"...\",\"scenes\":[{\"scene_number\":1,\"visual\":\"...\",\"narration\":\"...\"}]}]"
      },
      "id": "827050b8-916a-41a0-bf8d-abc130c8265c",
      "name": "Generate Script Candidates",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.6,
      "position": [
        672,
        192
      ]
    },
    {
      "parameters": {
        "jsCode": "const text = $json.text ?? '';\nconst raw = text.trim().replace(/^```(?:json)?\\s*/, '').replace(/\\s*```$/, '');\nconst scripts = JSON.parse(raw);\nreturn scripts.map(s => ({ json: s }));"
      },
      "id": "ade74bfc-3a5b-471d-9a25-2e258e57bb1b",
      "name": "Parse Scripts JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        192
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Score this children's script (ages 2-6 YouTube audience) out of 100. Return ONLY JSON, no other text: {\"total\":0,\"educational_value\":0,\"moral_clarity\":0,\"engagement_hook\":0,\"rhyme_language_quality\":0,\"age_appropriateness\":0,\"originality\":0,\"one_line_verdict\":\"\"}. Weights: educational_value out of 25, moral_clarity out of 20, engagement_hook out of 20, rhyme_language_quality out of 15, age_appropriateness out of 10, originality out of 10. Title: {{ $json.title }}. Moral: {{ $json.moral }}. Scenes: {{ JSON.stringify($json.scenes) }}"
      },
      "id": "d75e02f2-083b-4ce7-b956-53a6f1942e63",
      "name": "Score Script",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.6,
      "position": [
        1120,
        192
      ]
    },
    {
      "parameters": {
        "jsCode": "const scores = $input.all();\nconst scripts = $('Parse Scripts JSON').all();\nconst out = [];\nfor (let i = 0; i < scripts.length; i++) {\n  const t = (scores[i]?.json?.text ?? '{}').trim().replace(/^```(?:json)?\\s*/, '').replace(/\\s*```$/, '');\n  let score;\n  try { score = JSON.parse(t); } catch (e) { score = { total: 0, one_line_verdict: 'unparseable' }; }\n  out.push({ json: { ...scripts[i].json, score } });\n}\nreturn out;"
      },
      "id": "586e0165-c4db-45bc-9449-13d35bebe5cd",
      "name": "Merge Scores Into Scripts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        192
      ]
    },
    {
      "parameters": {
        "sortFieldsUi": {
          "sortField": [
            {
              "fieldName": "score.total",
              "order": "descending"
            }
          ]
        },
        "options": {}
      },
      "id": "c564b954-f75d-4ac3-adcf-d97df4040352",
      "name": "Sort By Score",
      "type": "n8n-nodes-base.sort",
      "typeVersion": 1,
      "position": [
        1568,
        192
      ]
    },
    {
      "parameters": {
        "jsCode": "const top = $input.all().slice(0, 5);\nconst LF = String.fromCharCode(10);\nlet msg = 'Top script candidates:' + LF + LF;\ntop.forEach((item, i) => {\n  const s = item.json;\n  msg += (i + 1) + '. ' + s.title + ' - Score: ' + (s.score?.total ?? 'N/A') + '/100' + LF;\n  msg += '   Moral: ' + s.moral + LF;\n  msg += '   Verdict: ' + (s.score?.one_line_verdict ?? '') + LF + LF;\n});\nmsg += 'Reply with the number to approve, or \"none\" to skip this run.';\nreturn [{ json: { message: msg, candidates: top } }];"
      },
