      "parameters": {
        "jsCode": "const reply = ($json.data?.text ?? '').trim();\nif (reply.toLowerCase() === 'none') { return [{ json: { approved: false } }]; }\nconst index = parseInt(reply, 10) - 1;\nconst candidates = $('Format Top 5 for Telegram').first().json.candidates;\nconst chosen = candidates?.[index]?.json;\nif (!chosen) { return [{ json: { approved: false } }]; }\nreturn [{ json: { approved: true, ...chosen } }];"
      },
