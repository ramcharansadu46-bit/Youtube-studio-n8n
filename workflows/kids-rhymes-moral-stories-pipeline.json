        "mode": "runOnceForEachItem",
        "jsCode": "const bin = $binary?.data;\nconst mime = (bin?.mimeType || '').toLowerCase();\nif (!mime.includes('audio') && !mime.includes('mpeg')) {\n  let body = '';\n  try { body = Buffer.from(bin?.data || '', 'base64').toString('utf8').slice(0, 300); } catch (e) { body = '(unreadable)'; }\n  throw new Error('VoiceRSS did not return audio (mimeType=\"' + mime + '\"). VoiceRSS said: ' + body);\n}\nreturn $input.item;"
